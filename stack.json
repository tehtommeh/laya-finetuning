    {
      "name": "api health",
      "url": "{api}/health",
      "expect_json_path": "status",
      "expect_equals": "ok"
    },
    {
      "name": "all three checkpoints listed",
      "url": "{api}/v1/models",
      "expect_json_path": "data.3.id",
      "expect_equals": "typed-decisions"
    },
    {
      "name": "gpu visible",
      "url": "{api}/info",
      "expect_json_path": "gpu.name"
    },
    {
      "name": "every checkpoint on the gpu",

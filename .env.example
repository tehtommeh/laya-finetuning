# Copy to .env and adjust: `cp .env.example .env`. Values were chosen for an RTX 3090
# (CC 8.6, 24GB); run `python3 scripts/preflight.py --workdir . --ports api=8001,frontend=7860`
# to check yours. Every value is a knob; no compose edits needed.

PROJECT_NAME=laya-local

# --- model -------------------------------------------------------------
MODEL_REPO=convaiinnovations/laya
# Path *inside* the container. ./models is mounted read-only at /models.
# The repo root is the English checkpoint; multilingual/ and typed-decisions/
# are sibling checkpoints in subfolders.
MODEL_DIR=/models/convaiinnovations__laya
SERVED_MODEL_NAME=laya
MODALITY=decision
# Which checkpoints to keep resident. All three are ~1.16B params (~2.4GB in
# bf16), so on a GPU there is no reason to lazy-load: a cold load costs
# seconds, while routing between resident checkpoints costs microseconds.
PRELOAD=english,multilingual,typed-decisions
DEFAULT_CHECKPOINT=english

# --- hardware (filled from preflight.py) --------------------------------
# The checkpoints were trained with bf16 autocast (amp_dtype=bf16); the SDK
# drops to fp16 automatically on pre-Ampere GPUs and fp32 on CPU.
DEVICE=cuda
GPU_COUNT=all
SHM_SIZE=2gb

# --- serving ------------------------------------------------------------
# The docs assume 8001 (8000 was taken on the machine this was built on).
API_PORT=8001
FRONTEND_PORT=7860
HEALTH_START_PERIOD=300s

# --- images -------------------------------------------------------------
# CUDA 12.6 runtime: works on any driver >= 560, not just this host's 580.
API_BASE_IMAGE=pytorch/pytorch:2.14.0-cuda12.6-cudnn9-runtime

# --- container user: set to the output of `id -u` / `id -g` --------------
LOCAL_UID=1000
LOCAL_GID=1000
